<%= render "recording_studio_attachable/providers/remote_file_browser",
           provider_label: provider_label,
           reconnect: @reconnect,
           show_connect: @show_connect,
           connect_url: @oauth_connect_path,
           connect_method: :post,
           connect_fields: {
             owner: "root",
             root_recording_id: dropbox_root&.id,
             return_to: @oauth_return_to,
             authenticity_token: form_authenticity_token
           },
           files: @files,
           query: @query,
           current_path: @current_path,
           parent_url: @parent_url,
           path: @path,
           next_page_url: @next_page_url,
           import_url: recording_imports_path(@recording),
           search_url: recording_imports_path(@recording),
           disconnect_url: recording_disconnect_path(@recording),
           recording: @recording,
           flow_params: upload_flow_params %>
