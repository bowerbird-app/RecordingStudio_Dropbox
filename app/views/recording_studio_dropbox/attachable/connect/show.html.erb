<%= render "recording_studio_attachable/providers/connect_form",
           provider_label: provider_label,
           reconnect: @reconnect,
           auto_submit: params[:popup].to_s == "1",
           connect_url: @oauth_connect_path,
           method: :post,
           fields: {
             owner: "user",
             return_to: @oauth_return_to,
             authenticity_token: form_authenticity_token
           } %>
