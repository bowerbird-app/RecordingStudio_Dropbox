<% dummy_page_nav(
  title: "Methods",
  subtitle: "Public methods on RecordingStudioDropbox::Client.",
  back_url: root_path
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Create a client",
    subtitle: "RecordingStudioDropbox::Client.new",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      token = RecordingStudioDropbox::OauthToken.new(
        root: root_recording,
        actor: current_user
      )
      client = RecordingStudioDropbox::Client.new(token_provider: token)

      page = client.list(path: "")
      file = client.download(path: page.entries.first.id)
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    See the product README for search, upload, and reconnect errors.
  </p>
</div>
