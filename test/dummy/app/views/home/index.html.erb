<% dummy_page_nav(title: "Dropbox", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Dropbox",
    subtitle: dropbox_home_subtitle,
    variant: :h1
  ) %>

  <% if notice.present? %>
    <%= render FlatPack::Alert::Component.new(style: :success, title: notice) %>
  <% end %>
  <% if alert.present? %>
    <%= render FlatPack::Alert::Component.new(style: :danger, title: alert) %>
  <% end %>

  <div class="flex flex-wrap gap-3">
    <% if @dropbox_connection.nil? %>
      <%= form_with url: recording_studio_oauth.outbound_connect_path(provider: "dropbox"), method: :post do %>
        <%= hidden_field_tag :owner, "user" %>
        <%= hidden_field_tag :return_to, root_path %>
        <%= render FlatPack::Button::Component.new(
          text: "Connect Dropbox",
          style: :primary,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
    <% elsif @dropbox_connection.needs_reconnect? %>
      <%= form_with url: recording_studio_oauth.outbound_connect_path(provider: "dropbox"), method: :post do %>
        <%= hidden_field_tag :owner, "user" %>
        <%= hidden_field_tag :return_to, root_path %>
        <%= render FlatPack::Button::Component.new(
          text: "Reconnect Dropbox",
          style: :danger,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
      <%= form_with url: recording_studio_oauth.outbound_connection_path(@dropbox_connection), method: :delete do %>
        <%= hidden_field_tag :return_to, root_path %>
        <%= render FlatPack::Button::Component.new(
          text: "Disconnect",
          style: :secondary,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
    <% else %>
      <%= form_with url: recording_studio_oauth.outbound_connection_path(@dropbox_connection), method: :delete do %>
        <%= hidden_field_tag :return_to, root_path %>
        <%= render FlatPack::Button::Component.new(
          text: "Disconnect",
          style: :primary,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
    <% end %>
  </div>
</div>
