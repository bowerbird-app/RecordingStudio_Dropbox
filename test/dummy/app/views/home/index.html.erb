<% dummy_page_nav(title: "Dropbox client", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Dropbox client",
    subtitle: "This dummy app boots the Recording Studio Dropbox engine in a host.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "What this gem does",
          subtitle: "A Dropbox HTTP client. Tokens come from a token provider.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>List and search folders with cursor paging.</li>
          <li>Fetch metadata, download a file, and upload a file.</li>
          <li>Large uploads use Dropbox upload sessions.</li>
          <li>Expired, revoked, and missing-scope tokens raise ReconnectRequired.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Not in this release",
          subtitle: "Later phases register this gem as an Attachable upload source.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          Oauth <code>connection_for</code> is not a dependency yet. Pass a token provider in tests or in the host until that gem ships.
        </p>
      <% end %>
    <% end %>
  </div>
</div>
